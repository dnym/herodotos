{{template "header" .}}

{{$d := .Inner}}
<section class="hero">
  <div class="hero-grid">
    <div>
      <h1>{{$d.Snap.Meta.WorldName}}</h1>
      <p class="facts">{{$d.Snap.Meta.Revision}} committed revision(s){{if $d.Pending}} ·
        <a href="/attempts">{{$d.Pending}} report(s) still in transit</a>{{end}}</p>
    </div>
    <div class="clock">
      <span class="date">{{$d.Date}}</span>
      <span class="sub">step {{$d.Snap.Meta.ClockStep}} · {{$d.Snap.Meta.StepDays}}-day steps</span>
    </div>
  </div>
  {{template "runpanel" $d.Panel}}
</section>

<section>
  <h2>Regions</h2>
  <table>
    <tr><th>id</th><th>name</th><th>status</th><th>canonical conditions</th><th>memory</th></tr>
    {{range $id, $r := $d.Snap.Regions}}
    <tr>
      <td><a class="chip" href="/events?region={{$id}}">{{$id}}</a></td>
      <td>{{$r.Name}}</td>
      <td class="status-{{$r.Status}}">{{$r.Status}}</td>
      <td class="attrs">{{range $a := index $d.Attrs $id}}<div>{{$a}}</div>{{end}}</td>
      <td class="memory">{{with index $d.Snap.Memories $id}}{{.Summary}}{{end}}</td>
    </tr>
    {{end}}
  </table>
</section>

{{if $d.Snap.Directives}}
<section>
  <h2>Directives</h2>
  <p class="hint">Creative direction, not fact. You can reword directives here;
  the historians never change them themselves.</p>
  <table class="directives">
    <tr><th>id</th><th>kind</th><th>status</th><th>text</th></tr>
    {{range $id, $dir := $d.Snap.Directives}}
    <tr>
      <td><code>{{$id}}</code></td>
      <td>{{if $dir.Hard}}hard{{else}}soft{{end}}</td>
      <td class="status-{{$dir.Status}}">{{$dir.Status}}</td>
      <td>
        <form method="post" action="/directive/edit" class="dirform">
          <input type="hidden" name="id" value="{{$id}}">
          <textarea name="text" rows="2" maxlength="500">{{$dir.Text}}</textarea>
          <button type="submit" class="secondary">save</button>
        </form>
      </td>
    </tr>
    {{end}}
  </table>
  <form method="post" action="/directive/add" class="dirform adddir">
    <textarea name="text" rows="2" maxlength="500" placeholder="a new directive for the historians…"></textarea>
    <label class="hardbox"><input type="checkbox" name="hard" value="1"> hard</label>
    <button type="submit" class="secondary">add directive</button>
  </form>
</section>
{{else}}
<section>
  <h2>Directives</h2>
  <form method="post" action="/directive/add" class="dirform adddir">
    <textarea name="text" rows="2" maxlength="500" placeholder="a directive for the historians…"></textarea>
    <label class="hardbox"><input type="checkbox" name="hard" value="1"> hard</label>
    <button type="submit" class="secondary">add directive</button>
  </form>
</section>
{{end}}

<section>
  <h2>Entities</h2>
  <table>
    <tr><th>id</th><th>kind</th><th>name</th><th>region</th><th>status</th></tr>
    {{range $id, $e := $d.Snap.Entities}}
    <tr>
      <td><code>{{$id}}</code></td>
      <td>{{$e.Kind}}</td>
      <td>{{$e.Name}}</td>
      <td><a class="chip" href="/events?region={{$e.RegionID}}">{{$e.RegionID}}</a></td>
      <td class="status-{{$e.Status}}">{{$e.Status}}</td>
    </tr>
    {{end}}
  </table>
</section>

<section>
  <h2>Latest events</h2>
  {{if not $d.Snap.RecentEvents}}
  <p class="hint">Nothing has happened yet. Advance a step to write the first page.</p>
  {{end}}
  <ul class="events">
    {{range $ev := $d.Snap.RecentEvents}}
    <li>
      <div class="title"><a href="/event?id={{$ev.ID}}">{{$ev.Title}}</a></div>
      <div class="prose"><p>{{$ev.Prose}}</p></div>
      <div class="meta-line">
        <span class="tag">{{$ev.Type}}</span>
        <span class="rel">step {{$ev.Step}}</span>
        {{if $ev.CauseIDs}}<span class="rel">arose from</span>
          {{range $c := $ev.CauseIDs}}<a class="chip" href="/event?id={{$c}}">{{$c}}</a>{{end}}
        {{end}}
      </div>
    </li>
    {{end}}
  </ul>
  <p class="paging"><a href="/events">full timeline</a></p>
</section>

{{template "footer" .}}
