{{define "header"}}<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{.Title}} — herodotos</title>
  <link rel="stylesheet" href="/static/style.css">
  <script src="/static/htmx.min.js" defer></script>
</head>
<body>
<header class="top">
  <span class="brand"><a href="/">herodotos</a></span>
  <nav>
    <a href="/"{{if eq .Section "overview"}} class="current"{{end}}>overview</a>
    <a href="/events"{{if eq .Section "events"}} class="current"{{end}}>timeline</a>
    <a href="/attempts"{{if eq .Section "attempts"}} class="current"{{end}}>attempts</a>
    <a href="/references"{{if eq .Section "references"}} class="current"{{end}}>references</a>
    <a href="/export">export</a>
  </nav>
</header>
<main>
{{if .Flash}}<p class="flash {{if .FlashErr}}err{{end}}">{{.Flash}}</p>{{end}}
{{end}}

{{define "footer"}}
</main>
<footer>canonical state and committed events are authoritative; prose and
memory only describe them</footer>
</body>
</html>
{{end}}
