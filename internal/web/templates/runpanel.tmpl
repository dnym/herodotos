{{define "runpanel"}}
{{if .WorldPause}}
<div class="runpanel paused" hx-get="/run/panel" hx-trigger="every 4s" hx-swap="outerHTML">
  <p class="flash err">The world is paused: {{.WorldPause}}</p>
  <p class="hint">No step will commit until the conflict is resolved — adjust the directive
  below, then resume. History is untouched.</p>
  <form method="post" action="/run/resume" class="stepform">
    <button type="submit">resume world</button>
    <span class="hint">the next attempt adjudicates afresh</span>
  </form>
</div>
{{else if .Active}}
<div class="runpanel running" hx-get="/run/panel" hx-trigger="every 4s" hx-swap="outerHTML">
  <p class="runstatus"><span class="pulse"></span>
    Run in progress — {{.StepsDone}} step(s) committed so far.
    Closing this page does not stop it.</p>
  {{if .PauseReq}}
  <p class="hint">pause requested: the run stops at the next step boundary</p>
  {{else}}
  <form method="post" action="/run/pause" class="stepform">
    <button type="submit" class="secondary">pause at the next step boundary</button>
  </form>
  {{end}}
</div>
{{else if not .HasEngine}}
<p class="hint">no inference configured — start <code>serve</code> with
<code>HERODOTOS_INFERENCE_BASE_URL</code>/<code>HERODOTOS_INFERENCE_MODEL</code>
(or <code>--scripted</code>) to advance the world from here</p>
{{else}}
<div class="runpanel">
  <form method="post" action="/run/start" class="stepform">
    <input type="hidden" name="steps" value="1">
    <button type="submit">advance one step</button>
    <span class="hint">runs on the server; a live step takes minutes and survives closing this tab</span>
  </form>
  <form method="post" action="/run/start" class="stepform">
    <input type="hidden" name="steps" value="all">
    <button type="submit" class="secondary">run until stopped</button>
  </form>
  {{if .LastResult}}<p class="hint lastresult">{{.LastResult}}</p>{{end}}
  {{if .LastErr}}<p class="flash err">{{.LastErr}} &mdash;
    <a href="/attempts">attempt diagnostics</a></p>{{end}}
</div>
{{end}}
{{end}}
