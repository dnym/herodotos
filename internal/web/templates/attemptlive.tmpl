{{define "attemptlive"}}
{{$d := .}}
{{$live := eq $d.Attempt.Status "running"}}
{{if $live}}
<div class="livewrap" hx-get="/attempt?id={{$d.Attempt.ID}}" hx-trigger="every 4s" hx-swap="outerHTML">
{{else}}
<div class="livewrap">
{{end}}

<p class="attempt-status status-{{$d.Attempt.Status}}">
  {{if $live}}step {{$d.Attempt.Step}} in progress &mdash; the historians are at work; this section refreshes as calls land
  {{else if eq $d.Attempt.Status "committed"}}committed
  {{else}}failed: {{$d.Attempt.Error}}{{if $d.Attempt.PauseReason}} &mdash; halted the world: {{$d.Attempt.PauseReason}}{{end}}{{end}}
</p>
{{if $d.Attempt.Detail}}<pre class="faildetail">{{$d.Attempt.Detail}}</pre>{{end}}

{{if $d.Outcomes}}
<section>
  <h2>What adjudication did with each proposal</h2>
  <p class="hint">"accepted" means a committed event carries the proposal unchanged; only then
  does the region's draft memory stand without reconciliation. Reasons are the orchestrator's
  and are never shown to regional historians.</p>
  <table>
    <tr><th>ref</th><th>author</th><th>proposal</th><th>outcome</th><th>orchestrator said</th><th>reason</th></tr>
    {{range $o := $d.Outcomes}}
    <tr>
      <td><code>{{$o.Ref}}</code></td>
      <td>{{$o.Author}}</td>
      <td>{{$o.Title}}</td>
      <td class="outcome-{{$o.Outcome}}">{{$o.Outcome}}</td>
      <td>{{if $o.Declared}}{{$o.Declared}}{{else}}<span class="hint">&mdash;</span>{{end}}</td>
      <td>{{$o.Reason}}</td>
    </tr>
    {{end}}
  </table>
</section>
{{end}}

<section>
  <h2>Proposals (agent output; never canonical on their own)</h2>
  {{if not $d.Proposals}}<p class="hint">None recorded{{if $live}} yet{{end}}.</p>{{end}}
  {{range $p := $d.Proposals}}
  <article class="proposal">
    <p><strong>{{$p.Author}}</strong> <span class="type">{{$p.Kind}}</span> <code>{{$p.ID}}</code></p>
    <blockquote>{{$p.Prose}}</blockquote>
    <details><summary>structured changes</summary>
      <pre>changes:        {{$p.Changes}}
affects_regions: {{$p.AffectsRegions}}
affects_entities:{{$p.AffectsEntities}}
causes:          {{$p.Causes}}
delivery:        {{$p.Delivery}}</pre>
    </details>
  </article>
  {{end}}
</section>

<section>
  <h2>Model calls</h2>
  {{if not $d.Calls}}<p class="hint">None recorded{{if $live}} yet{{end}}.</p>{{end}}
  <table>
    <tr><th>#</th><th>role</th><th>model</th><th>settings</th><th>in</th><th>out</th><th>ms</th><th>outcome</th></tr>
    {{range $c := $d.Calls}}
    <tr>
      <td>{{$c.Seq}}</td>
      <td><code>{{$c.Role}}</code></td>
      <td>{{$c.Model}}</td>
      <td class="settings">{{if $c.MaxTokens}}t={{$c.Temperature}} max_out={{$c.MaxTokens}}<br>prompt {{$c.PromptBytes}}{{if $c.PromptBudget}}/{{$c.PromptBudget}}{{end}} B{{else}}<span class="hint">&mdash;</span>{{end}}</td>
      <td>{{$c.InTokens}}</td>
      <td>{{$c.OutTokens}}</td>
      <td>{{$c.DurationMS}}</td>
      <td>
        {{if $c.Error}}<span class="err">{{$c.Error}}</span>{{else}}ok{{end}}
        {{if $c.Response}}<details><summary>reply</summary><pre class="reply">{{$c.Response}}</pre></details>{{end}}
      </td>
    </tr>
    {{end}}
  </table>
</section>

</div>
{{end}}
